        function getBadgeClass(gfOptions) {
            if (gfOptions.includes('100%')) return 'gf-100';
            if (gfOptions.includes('Dedicated')) return 'gf-dedicated';
            if (gfOptions.includes('Menu')) return 'gf-menu';
            return 'gf-options';
        }

        function renderRestaurants(filteredRestaurants) {
            const grid = document.getElementById('restaurant-grid');
            grid.innerHTML = '';
            
            filteredRestaurants.forEach(r => {
                const card = document.createElement('div');
                card.className = 'restaurant-card';
                card.innerHTML = `
                    <div class="restaurant-name">${r.name}</div>
                    <div class="neighborhood">${r.neighborhood}</div>
                    <div class="gf-badge ${getBadgeClass(r.gfOptions)}">${r.gfOptions}</div>
                    <div class="rating">${r.rating}</div>
                    <div class="cuisine-type">${r.cuisine} • <span class="price">${r.price}</span></div>
                    <div class="notes">${r.notes}</div>
                    <div class="contact-info">
                        📍 ${r.address}<br>
                        📞 ${r.phone}<br>
                        🌐 <a href="https://${r.website}" target="_blank">${r.website}</a>
                    </div>
                `;
                grid.appendChild(card);
            });
            
            document.getElementById('total-count').textContent = filteredRestaurants.length;
        }

        function filterRestaurants() {
            const searchTerm = document.getElementById('search').value.toLowerCase();
            const neighborhoodFilter = document.getElementById('neighborhood-filter').value;
            const gfFilter = document.getElementById('gf-filter').value;
            const cuisineFilter = document.getElementById('cuisine-filter').value;
            
            const filtered = restaurants.filter(r => {
                const matchesSearch = !searchTerm || 
                    r.name.toLowerCase().includes(searchTerm) ||
                    r.neighborhood.toLowerCase().includes(searchTerm) ||
                    r.cuisine.toLowerCase().includes(searchTerm) ||
                    r.notes.toLowerCase().includes(searchTerm);
                    
                const matchesNeighborhood = !neighborhoodFilter || 
                    r.neighborhood.includes(neighborhoodFilter);
                    
                const matchesGF = !gfFilter || 
                    r.gfOptions.includes(gfFilter);
                    
                const matchesCuisine = !cuisineFilter || 
                    r.cuisine.includes(cuisineFilter);
                    
                return matchesSearch && matchesNeighborhood && matchesGF && matchesCuisine;
            });
            
            renderRestaurants(filtered);
        }

        // Event listeners
        document.getElementById('search').addEventListener('input', filterRestaurants);
        document.getElementById('neighborhood-filter').addEventListener('change', filterRestaurants);
        document.getElementById('gf-filter').addEventListener('change', filterRestaurants);
        document.getElementById('cuisine-filter').addEventListener('change', filterRestaurants);

        // Initial render
        renderRestaurants(restaurants);
    </script>
</body>
</html>