---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
  AFFILIATE LINKS SETUP:
  1. Sign up for Amazon Associates at affiliate-program.amazon.com
  2. Replace "sdglutenfree-20" below with your actual Associate Tag
  3. All product links use Amazon search queries — no hardcoded ASINs that can expire
*/
const AMAZON_TAG = 'sdglutenfree-20'; // TODO: replace with your actual Associate Tag

const makeAmazonLink = (query: string) =>
  `https://www.amazon.com/s?k=${encodeURIComponent(query)}&tag=${AMAZON_TAG}`;

const products = [
  {
    category: "Pantry Staples",
    icon: "🫙",
    items: [
      {
        name: "Jovial Brown Rice Pasta",
        tagline: "The Gold Standard",
        description: "Texture is virtually indistinguishable from wheat pasta. Certified GF, made in a dedicated facility. A true pantry staple.",
        link: makeAmazonLink("jovial brown rice pasta gluten free"),
        badge: "Editor's Pick",
      },
      {
        name: "King Arthur Measure for Measure",
        tagline: "Best 1:1 Flour",
        description: "The best GF all-purpose flour for baking. Perfect 1:1 swap in almost every recipe — cakes, cookies, pancakes.",
        link: makeAmazonLink("king arthur measure for measure gluten free flour"),
        badge: null,
      },
      {
        name: "Bob's Red Mill GF Oats",
        tagline: "Certified Purity Protocol",
        description: "Purity Protocol oats are tested for gluten. Perfect for overnight oats and baking. Always verify with your doctor if celiac.",
        link: makeAmazonLink("bob's red mill gluten free oats certified"),
        badge: null,
      },
      {
        name: "Canyon Bakehouse Bread",
        tagline: "Best GF Sandwich Bread",
        description: "The closest thing to 'real' sandwich bread in the GF world. Soft, freezes well, and dedicated GF bakery.",
        link: makeAmazonLink("canyon bakehouse gluten free bread"),
        badge: "Community Fave",
      },
    ]
  },
  {
    category: "Snacks & On-the-Go",
    icon: "🎒",
    items: [
      {
        name: "Simple Mills Crackers",
        tagline: "Almond Flour Based",
        description: "Made with almond flour, clean ingredients, incredible crunch. Perfect with cheese, hummus, or solo as a snack.",
        link: makeAmazonLink("simple mills almond flour crackers gluten free"),
        badge: null,
      },
      {
        name: "GoMacro Bars",
        tagline: "Certified GF + Organic",
        description: "The ultimate travel snack. Certified gluten-free, organic, plant-based, and packed with protein. Never leave home without a few.",
        link: makeAmazonLink("gomacro bars certified gluten free"),
        badge: "Travel Essential",
      },
      {
        name: "Siete Tortilla Chips",
        tagline: "Grain-Free & Delicious",
        description: "Made with cassava, avocado oil, and sea salt. Better ingredients than most GF chips, and crunchier too.",
        link: makeAmazonLink("siete grain free tortilla chips gluten free"),
        badge: null,
      },
      {
        name: "Enjoy Life Chocolate Chips",
        tagline: "Free From 14 Allergens",
        description: "Certified GF and free from the top 14 allergens. Great for baking and snacking. Dairy-free too.",
        link: makeAmazonLink("enjoy life chocolate chips gluten free allergy free"),
        badge: null,
      },
    ]
  },
  {
    category: "Kitchen Safety",
    icon: "🍳",
    items: [
      {
        name: "Dedicated GF Toaster",
        tagline: "#1 Cross-Contamination Risk",
        description: "A toaster used for regular bread CANNOT be safely used for GF bread. A dedicated GF toaster is non-negotiable for celiacs.",
        link: makeAmazonLink("dedicated gluten free toaster color coded"),
        badge: "Must-Have",
      },
      {
        name: "Nima Sensor Gluten Tester",
        tagline: "Test Your Food Anywhere",
        description: "Portable gluten tester that detects gluten in food samples. Peace of mind when dining out. The best investment for frequent diners.",
        link: makeAmazonLink("nima sensor portable gluten tester"),
        badge: "Game Changer",
      },
      {
        name: "Color-Coded Cutting Boards",
        tagline: "Prevent Cross-Contact",
        description: "Dedicated color-coded boards for GF prep prevent cross-contamination at home. Simple, effective, affordable.",
        link: makeAmazonLink("color coded cutting board set kitchen"),
        badge: null,
      },
      {
        name: "Gluten Intolerance Group Kit",
        tagline: "GFFS Certification Info",
        description: "The Gluten-Free Food Service Training Kit — perfect for restaurants wanting to get certified. Share with local restaurants.",
        link: makeAmazonLink("gluten free kitchen safety guide training"),
        badge: null,
      },
    ]
  },
  {
    category: "Dining Out Tools",
    icon: "🍽️",
    items: [
      {
        name: "GlutenTox Home Test Kit",
        tagline: "R5 ELISA Based",
        description: "Test food for gluten at restaurants or at home using the same antibody technology as professional labs.",
        link: makeAmazonLink("glutentox home test kit gluten detection"),
        badge: null,
      },
      {
        name: "Celiac Disease for Dummies",
        tagline: "Essential Reading",
        description: "The best comprehensive guide to living gluten-free. From diagnosis to dining out — covers everything.",
        link: makeAmazonLink("celiac disease book guide gluten free living"),
        badge: "Highly Rated",
      },
      {
        name: "Gluten-Free Restaurant Cards",
        tagline: "Print & Carry",
        description: "Chef cards explaining celiac disease in multiple languages. Hand them to servers and kitchen staff when dining out.",
        link: makeAmazonLink("gluten free dining cards celiac restaurant"),
        badge: null,
      },
    ]
  },
];
---

<BaseLayout
  title="GF Essentials — San Diego Gluten-Free"
  description="Our curated picks for the best gluten-free pantry staples, snacks, and kitchen tools. Affiliate links support the SD Gluten-Free community."
>
  <main>
    <!-- Hero -->
    <section class="essentials-hero">
      <div class="container">
        <p class="eyebrow">Community Picks</p>
        <h1>GF <span class="accent">Essentials</span></h1>
        <p class="subtitle">Products we actually use and recommend for a safe, delicious gluten-free life in San Diego — and beyond.</p>
        <p class="affiliate-disclosure">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Affiliate disclosure: We earn a small commission when you buy through our links, at no extra cost to you. This helps keep the directory free.
        </p>
      </div>
      <div class="hero-pattern"></div>
    </section>

    <!-- Products by Category -->
    <section class="products-section">
      <div class="container">
        {products.map(category => (
          <div class="category-block">
            <div class="category-header">
              <span class="category-icon">{category.icon}</span>
              <h2>{category.category}</h2>
            </div>
            <div class="product-grid">
              {category.items.map(product => (
                <div class="product-card">
                  {product.badge && (
                    <div class="product-badge">{product.badge}</div>
                  )}
                  <div class="product-body">
                    <div class="product-tagline">{product.tagline}</div>
                    <h3>{product.name}</h3>
                    <p class="product-description">{product.description}</p>
                  </div>
                  <a href={product.link} target="_blank" rel="noopener sponsored" class="product-cta">
                    View on Amazon
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
                  </a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Support Banner -->
    <section class="support-banner">
      <div class="container support-inner">
        <div>
          <h2>Support SD Gluten-Free</h2>
          <p>Every purchase through our links helps keep this directory free, updated, and independent. Thank you for supporting the community.</p>
        </div>
        <a href="/" class="btn-back">Back to Directory →</a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
      <div class="container footer-content">
        <div class="footer-brand">
          <h3>SD Gluten-Free</h3>
          <p>Curated for the celiac community of San Diego.</p>
          <div class="footer-nav">
            <a href="/">Directory</a>
            <a href="/essentials">GF Essentials</a>
            <a href="/advertise">Advertise</a>
          </div>
        </div>
        <div class="footer-meta">
          <p>&copy; 2026 SD Gluten-Free &middot; San Diego, CA</p>
          <p class="aff-note">SD Gluten-Free is a participant in the Amazon Services LLC Associates Program.</p>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  /* Hero */
  .essentials-hero {
    background: var(--text-primary);
    color: var(--bg-primary);
    padding: 5rem 0 7rem;
    position: relative;
    overflow: hidden;
  }

  .eyebrow {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent-primary);
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 3.8rem);
    margin-bottom: 1rem;
    color: var(--bg-primary);
  }

  .accent {
    color: var(--accent-primary);
    font-style: italic;
  }

  .subtitle {
    font-size: 1.1rem;
    opacity: 0.75;
    margin-bottom: 1.5rem;
    max-width: 540px;
    line-height: 1.7;
  }

  .affiliate-disclosure {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,255,255,0.08);
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: rgba(250,246,241,0.6);
    max-width: 580px;
    line-height: 1.5;
  }

  .affiliate-disclosure svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  .hero-pattern {
    position: absolute;
    top: 0; right: 0;
    width: 50%; height: 100%;
    background-image: radial-gradient(var(--accent-primary) 0.5px, transparent 0.5px);
    background-size: 20px 20px;
    opacity: 0.08;
    z-index: 1;
    mask-image: linear-gradient(to left, black, transparent);
  }

  .essentials-hero .container {
    position: relative;
    z-index: 2;
  }

  /* Products Section */
  .products-section {
    padding: 4rem 0;
  }

  .category-block {
    margin-bottom: 4rem;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--border);
  }

  .category-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .category-header h2 {
    font-size: 1.75rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
  }

  .product-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .product-badge {
    background: var(--accent-primary);
    color: white;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    width: fit-content;
    border-radius: 0 0 4px 0;
  }

  .product-body {
    padding: 1.25rem 1.25rem 0;
    flex-grow: 1;
  }

  .product-tagline {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    margin-bottom: 0.4rem;
  }

  .product-body h3 {
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .product-description {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .product-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    margin: 0 1.25rem 1.25rem;
    background: var(--bg-secondary);
    color: var(--text-primary);
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.15s, color 0.15s;
    border: 1px solid var(--border);
  }

  .product-cta:hover {
    background: var(--accent-primary);
    color: white;
    border-color: var(--accent-primary);
  }

  /* Support Banner */
  .support-banner {
    background: var(--text-primary);
    padding: 4rem 0;
  }

  .support-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .support-banner h2 {
    font-size: 1.75rem;
    color: white;
    margin-bottom: 0.5rem;
  }

  .support-banner p {
    color: rgba(250,246,241,0.65);
    font-size: 0.95rem;
    max-width: 500px;
    line-height: 1.6;
  }

  .btn-back {
    white-space: nowrap;
    padding: 0.8rem 1.5rem;
    background: var(--accent-primary);
    color: white;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    flex-shrink: 0;
    transition: background 0.15s;
  }

  .btn-back:hover {
    background: var(--accent-hover);
  }

  /* Footer */
  .footer {
    background: #111122;
    color: var(--bg-secondary);
    padding: 3rem 0;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .footer-brand h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
    color: white;
  }

  .footer-brand > p {
    font-size: 0.875rem;
    opacity: 0.5;
    margin-bottom: 0.75rem;
  }

  .footer-nav {
    display: flex;
    gap: 1.25rem;
  }

  .footer-nav a {
    color: rgba(250,246,241,0.45);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.15s;
  }

  .footer-nav a:hover {
    color: var(--bg-primary);
  }

  .footer-meta {
    text-align: right;
  }

  .footer-meta p {
    font-size: 0.8rem;
    opacity: 0.4;
    margin-bottom: 0.25rem;
  }

  .aff-note {
    font-size: 0.72rem !important;
    opacity: 0.25 !important;
    max-width: 260px;
    margin-left: auto;
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .product-grid {
      grid-template-columns: 1fr 1fr;
    }
    .support-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-content {
      flex-direction: column;
    }
    .footer-meta {
      text-align: left;
    }
    .aff-note {
      margin-left: 0;
    }
  }

  @media (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
