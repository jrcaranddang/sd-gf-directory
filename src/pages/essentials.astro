---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="GF Essentials - San Diego Gluten-Free">
	<main class="container py-12">
		<header class="mb-12 text-center">
			<h1 class="text-4xl font-bold mb-4">GF Essentials</h1>
			<p class="text-xl text-gray-600">The products we actually use and recommend for a safe, delicious GF life.</p>
		</header>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- Pantry Staples -->
			<div class="category-section">
				<h2 class="text-2xl font-semibold mb-6 border-b pb-2">Pantry Staples</h2>
				<div class="space-y-6">
					<div class="product-card p-4 border rounded-lg hover:shadow-md transition">
						<h3 class="font-bold">Jovial Brown Rice Pasta</h3>
						<p class="text-sm text-gray-600 mb-4">The gold standard for GF pasta. Texture is indistinguishable from wheat.</p>
						<a href="#" class="btn btn-sm btn-outline">View on Amazon</a>
					</div>
					<div class="product-card p-4 border rounded-lg hover:shadow-md transition">
						<h3 class="font-bold">King Arthur Measure for Measure</h3>
						<p class="text-sm text-gray-600 mb-4">Best all-purpose flour for baking 1:1 swaps.</p>
						<a href="#" class="btn btn-sm btn-outline">View on Amazon</a>
					</div>
				</div>
			</div>

			<!-- Snacks & Travel -->
			<div class="category-section">
				<h2 class="text-2xl font-semibold mb-6 border-b pb-2">Snacks & Travel</h2>
				<div class="space-y-6">
					<div class="product-card p-4 border rounded-lg hover:shadow-md transition">
						<h3 class="font-bold">Simple Mills Crackers</h3>
						<p class="text-sm text-gray-600 mb-4">Almond flour based, clean ingredients, incredible crunch.</p>
						<a href="#" class="btn btn-sm btn-outline">View on Amazon</a>
					</div>
					<div class="product-card p-4 border rounded-lg hover:shadow-md transition">
						<h3 class="font-bold">GoMacro Bars</h3>
						<p class="text-sm text-gray-600 mb-4">The ultimate travel snack. Certified GF and protein-packed.</p>
						<a href="#" class="btn btn-sm btn-outline">View on Amazon</a>
					</div>
				</div>
			</div>

			<!-- Kitchen Tools -->
			<div class="category-section">
				<h2 class="text-2xl font-semibold mb-6 border-b pb-2">Kitchen Tools</h2>
				<div class="space-y-6">
					<div class="product-card p-4 border rounded-lg hover:shadow-md transition">
						<h3 class="font-bold">Dedicated GF Toaster</h3>
						<p class="text-sm text-gray-600 mb-4">Crucial for preventing cross-contamination at home.</p>
						<a href="#" class="btn btn-sm btn-outline">View on Amazon</a>
					</div>
					<div class="product-card p-4 border rounded-lg hover:shadow-md transition">
						<h3 class="font-bold">Nima Sensor</h3>
						<p class="text-sm text-gray-600 mb-4">Portable gluten tester for peace of mind while dining out.</p>
						<a href="#" class="btn btn-sm btn-outline">View on Amazon</a>
					</div>
				</div>
			</div>
		</div>

		<section class="mt-16 p-8 bg-gray-50 rounded-xl text-center">
			<h2 class="text-2xl font-bold mb-4">Support SD Gluten-Free</h2>
			<p class="max-w-2xl mx-auto mb-6">We earn a small commission when you purchase through our links, which helps us keep the directory updated and free for the community!</p>
			<a href="/" class="btn btn-primary">Back to Directory</a>
		</section>
	</main>
</BaseLayout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}
	.py-12 { padding-top: 3rem; padding-bottom: 3rem; }
	.mb-12 { margin-bottom: 3rem; }
	.mb-4 { margin-bottom: 1rem; }
	.mb-6 { margin-bottom: 1.5rem; }
	.mt-16 { margin-top: 4rem; }
	.text-center { text-align: center; }
	.text-4xl { font-size: 2.25rem; }
	.text-2xl { font-size: 1.5rem; }
	.font-bold { font-weight: 700; }
	.font-semibold { font-weight: 600; }
	.text-gray-600 { color: #4b5563; }
	.text-sm { font-size: 0.875rem; }
	.grid { display: grid; }
	.gap-8 { gap: 2rem; }
	.border { border: 1px solid #e5e7eb; }
	.border-b { border-bottom: 1px solid #e5e7eb; }
	.rounded-lg { border-radius: 0.5rem; }
	.rounded-xl { border-radius: 0.75rem; }
	.p-4 { padding: 1rem; }
	.p-8 { padding: 2rem; }
	.bg-gray-50 { background-color: #f9fafb; }
	
	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		border-radius: 0.375rem;
		font-weight: 600;
		text-decoration: none;
		transition: background-color 0.2s;
	}
	.btn-primary {
		background-color: var(--accent-primary, #c45d3e);
		color: white;
	}
	.btn-outline {
		border: 1px solid var(--accent-primary, #c45d3e);
		color: var(--accent-primary, #c45d3e);
	}
	.btn-sm {
		padding: 0.5rem 1rem;
		font-size: 0.875rem;
	}

	@media (min-width: 768px) {
		.md\:grid-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
</style>
