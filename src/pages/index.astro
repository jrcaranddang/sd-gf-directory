---
import BaseLayout from '../layouts/BaseLayout.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import restaurants from '../data/restaurants.json';

const totalRestaurants = restaurants.length;
const neighborhoods = [...new Set(restaurants.map(r => r.neighborhood))].length;
const cuisineTypes = [...new Set(restaurants.map(r => r.cuisine))].length;

const featuredRestaurants = restaurants.filter(r => r.featured);
const regularRestaurants = restaurants.filter(r => !r.featured);
---

<BaseLayout title="San Diego Gluten-Free — Celiac-Safe Dining Guide">
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="container hero-content">
				<div class="hero-text">
					<p class="hero-eyebrow">San Diego's #1 Celiac Resource</p>
					<h1>Find Gluten-Free <br/><span class="accent">Dining in SD</span></h1>
					<p class="subtitle">A curated guide to celiac-safe restaurants in America's Finest City. Vetted, trusted, updated regularly.</p>

					<div class="cta-group">
						<a href="#directory" class="btn btn-primary">Explore Directory</a>
						<a href="/essentials" class="btn btn-secondary">GF Essentials</a>
					</div>
				</div>
			</div>

			<div class="hero-pattern"></div>
		</section>

		<!-- Stats Bar -->
		<section class="stats">
			<div class="container stats-container">
				<div class="stat-item">
					<span class="stat-value">{totalRestaurants}+</span>
					<span class="stat-label">Vetted Spots</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-value">{neighborhoods}</span>
					<span class="stat-label">Neighborhoods</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-value">{cuisineTypes}</span>
					<span class="stat-label">Cuisines</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-value">Free</span>
					<span class="stat-label">Always</span>
				</div>
			</div>
		</section>

		<!-- Newsletter Signup -->
		<section class="newsletter-section">
			<div class="container">
				<div class="newsletter-card">
					<div class="newsletter-text">
						<h3>Get Weekly GF Finds</h3>
						<p>New celiac-safe spots, exclusive deals, and local GF news — straight to your inbox.</p>
					</div>
					<!-- Replace YOUR_BUTTONDOWN_USERNAME with your Buttondown.email username -->
					<form action="https://buttondown.email/api/emails/embed-subscribe/sdglutenfree" method="post" target="popupwindow" class="newsletter-form">
						<input type="email" name="email" placeholder="your@email.com" required />
						<button type="submit">Subscribe Free</button>
					</form>
				</div>
			</div>
		</section>

		<!-- Ad Zone (leaderboard) -->
		<!--
		<section class="ad-zone">
			<div class="container">
				<div class="ad-label">Advertisement</div>
				<ins class="adsbygoogle ad-leaderboard"
					style="display:block"
					data-ad-client="ca-pub-XXXXXXXXXX"
					data-ad-slot="XXXXXXXXXX"
					data-ad-format="auto"
					data-full-width-responsive="true">
				</ins>
				<script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
			</div>
		</section>
		-->

		<!-- Featured / Sponsored Restaurants -->
		{featuredRestaurants.length > 0 && (
			<section class="featured-section">
				<div class="container">
					<div class="featured-header">
						<div>
							<h2>Featured Restaurants</h2>
							<p>Spotlight on SD's top celiac-safe dining experiences.</p>
						</div>
						<a href="/advertise" class="featured-cta-link">
							Get Featured →
						</a>
					</div>
					<div class="restaurant-grid featured-grid">
						{featuredRestaurants.map(restaurant => (
							<div class="restaurant-card-wrapper"
								data-name={restaurant.name.toLowerCase()}
								data-neighborhood={restaurant.neighborhood.toLowerCase()}
								data-cuisine={restaurant.cuisine.toLowerCase()}
								data-notes={restaurant.notes.toLowerCase()}
							>
								<RestaurantCard restaurant={restaurant} />
							</div>
						))}
					</div>
				</div>
			</section>
		)}

		<!-- Full Directory -->
		<section id="directory" class="directory">
			<div class="container">
				<div class="section-header">
					<h2>The Directory</h2>
					<p>Browse {totalRestaurants}+ celiac-safe spots by neighborhood, safety level, or cuisine.</p>
				</div>

				<div class="search-filter-container">
					<div class="search-wrapper">
						<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
						<input type="text" id="search" placeholder="Search restaurants, neighborhoods, or cuisine..." class="search-input" />
					</div>
				</div>

				<div class="legend">
					<span class="legend-item" style="color: var(--gf-verified)">
						<span class="legend-dot" style="background: var(--gf-verified)"></span>100% GF
					</span>
					<span class="legend-item" style="color: var(--gf-dedicated)">
						<span class="legend-dot" style="background: var(--gf-dedicated)"></span>Dedicated Menu
					</span>
					<span class="legend-item" style="color: var(--gf-menu)">
						<span class="legend-dot" style="background: var(--gf-menu)"></span>GF Menu Available
					</span>
					<span class="legend-item" style="color: var(--gf-options)">
						<span class="legend-dot" style="background: var(--gf-options)"></span>GF Options
					</span>
				</div>

				<div class="restaurant-grid" id="restaurant-grid">
					{regularRestaurants.map(restaurant => (
						<div class="restaurant-card-wrapper"
							data-name={restaurant.name.toLowerCase()}
							data-neighborhood={restaurant.neighborhood.toLowerCase()}
							data-cuisine={restaurant.cuisine.toLowerCase()}
							data-notes={restaurant.notes.toLowerCase()}
						>
							<RestaurantCard restaurant={restaurant} />
						</div>
					))}
				</div>

				<div id="no-results" class="no-results" style="display:none">
					<p>No restaurants match your search. <a href="/advertise">Know one we're missing?</a></p>
				</div>

				<!-- Mid-directory ad zone -->
				<!--
				<div class="ad-zone-inline">
					<div class="ad-label">Advertisement</div>
					<ins class="adsbygoogle"
						style="display:block"
						data-ad-client="ca-pub-XXXXXXXXXX"
						data-ad-slot="XXXXXXXXXX"
						data-ad-format="auto"
						data-full-width-responsive="true">
					</ins>
					<script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
				</div>
				-->
			</div>
		</section>

		<!-- Advertise CTA Banner -->
		<section class="advertise-banner">
			<div class="container advertise-banner-inner">
				<div>
					<h3>Own a gluten-free restaurant in San Diego?</h3>
					<p>Get a featured listing and reach thousands of local celiac diners every month.</p>
				</div>
				<a href="/advertise" class="btn btn-primary">See Listing Options</a>
			</div>
		</section>

		<!-- Footer -->
		<footer class="footer">
			<div class="container footer-content">
				<div class="footer-brand">
					<h3>SD Gluten-Free</h3>
					<p>Curated for the celiac community of San Diego.</p>
					<div class="footer-nav">
						<a href="/">Directory</a>
						<a href="/essentials">GF Essentials</a>
						<a href="/advertise">Advertise</a>
					</div>
				</div>
				<div class="footer-meta">
					<p>Last updated: March 2026 &middot; San Diego, CA</p>
					<p class="affiliate-note">Some links are affiliate links. We earn a small commission at no cost to you.</p>
				</div>
			</div>
		</footer>
	</main>

	<script>
		const searchInput = document.getElementById('search') as HTMLInputElement;
		const cards = document.querySelectorAll('.restaurant-card-wrapper');
		const noResults = document.getElementById('no-results');

		searchInput?.addEventListener('input', () => {
			const query = searchInput.value.toLowerCase();
			let visibleCount = 0;

			cards.forEach(card => {
				const el = card as HTMLElement;
				const name = el.dataset.name || '';
				const neighborhood = el.dataset.neighborhood || '';
				const cuisine = el.dataset.cuisine || '';
				const notes = el.dataset.notes || '';

				if (name.includes(query) || neighborhood.includes(query) || cuisine.includes(query) || notes.includes(query)) {
					el.style.display = 'block';
					visibleCount++;
				} else {
					el.style.display = 'none';
				}
			});

			if (noResults) {
				noResults.style.display = visibleCount === 0 ? 'block' : 'none';
			}
		});
	</script>
</BaseLayout>

<style>
	/* Hero Styles */
	.hero {
		background-color: var(--text-primary);
		color: var(--bg-primary);
		padding: 6rem 0 8rem;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		position: relative;
		z-index: 2;
	}

	.hero-text {
		max-width: 600px;
	}

	.hero-eyebrow {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent-primary);
		font-weight: 700;
		margin-bottom: 1rem;
	}

	h1 {
		font-size: clamp(2.8rem, 7vw, 4.5rem);
		margin-bottom: 1.5rem;
		color: var(--bg-primary);
	}

	.accent {
		color: var(--accent-primary);
		font-style: italic;
	}

	.subtitle {
		font-size: 1.15rem;
		opacity: 0.75;
		margin-bottom: 2.5rem;
		font-family: 'Outfit', sans-serif;
		line-height: 1.7;
	}

	.cta-group {
		display: flex;
		gap: 1rem;
	}

	.btn {
		padding: 0.85rem 1.75rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s ease;
		display: inline-block;
	}

	.btn-primary {
		background-color: var(--accent-primary);
		color: white;
	}

	.btn-primary:hover {
		background-color: var(--accent-hover);
	}

	.btn-secondary {
		background-color: transparent;
		color: var(--bg-primary);
		border: 1px solid rgba(250, 246, 241, 0.35);
	}

	.btn-secondary:hover {
		background-color: rgba(250, 246, 241, 0.1);
	}

	.hero-pattern {
		position: absolute;
		top: 0;
		right: 0;
		width: 50%;
		height: 100%;
		background-image: radial-gradient(var(--accent-primary) 0.5px, transparent 0.5px);
		background-size: 20px 20px;
		opacity: 0.1;
		z-index: 1;
		mask-image: linear-gradient(to left, black, transparent);
	}

	/* Stats Bar */
	.stats {
		background: var(--bg-secondary);
		padding: 2rem 0;
		border-bottom: 1px solid var(--border);
	}

	.stats-container {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 3rem;
	}

	.stat-item {
		text-align: center;
	}

	.stat-value {
		display: block;
		font-family: 'Fraunces', serif;
		font-size: 2.2rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-tertiary);
		font-weight: 600;
		margin-top: 0.25rem;
		display: block;
	}

	.stat-divider {
		width: 1px;
		height: 40px;
		background: var(--border);
	}

	/* Newsletter */
	.newsletter-section {
		background: var(--bg-secondary);
		padding: 0 0 3rem;
	}

	.newsletter-card {
		background: var(--accent-primary);
		border-radius: 8px;
		padding: 2rem 2.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin-top: -2rem;
		position: relative;
		z-index: 10;
		box-shadow: var(--shadow-lg);
	}

	.newsletter-text h3 {
		font-size: 1.4rem;
		color: white;
		margin-bottom: 0.25rem;
	}

	.newsletter-text p {
		color: rgba(255,255,255,0.85);
		font-size: 0.95rem;
	}

	.newsletter-form {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
	}

	.newsletter-form input {
		padding: 0.7rem 1rem;
		border-radius: 4px;
		border: none;
		font-family: 'Outfit', sans-serif;
		font-size: 0.9rem;
		width: 220px;
	}

	.newsletter-form input:focus {
		outline: 2px solid rgba(255,255,255,0.5);
	}

	.newsletter-form button {
		padding: 0.7rem 1.25rem;
		background: var(--text-primary);
		color: white;
		border: none;
		border-radius: 4px;
		font-family: 'Outfit', sans-serif;
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
		white-space: nowrap;
		transition: opacity 0.15s;
	}

	.newsletter-form button:hover {
		opacity: 0.85;
	}

	/* Featured Section */
	.featured-section {
		padding: 4rem 0 2rem;
		background: var(--featured-gold-bg);
		border-bottom: 1px solid var(--featured-gold-border);
	}

	.featured-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 2rem;
	}

	.featured-header h2 {
		font-size: 2rem;
		margin-bottom: 0.25rem;
	}

	.featured-header p {
		color: var(--text-secondary);
	}

	.featured-cta-link {
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--featured-gold);
		text-decoration: none;
		white-space: nowrap;
		padding-bottom: 0.25rem;
		border-bottom: 1px solid var(--featured-gold);
	}

	.featured-cta-link:hover {
		opacity: 0.8;
	}

	/* Directory Section */
	.directory {
		padding: 5rem 0 4rem;
	}

	.section-header {
		margin-bottom: 2rem;
		text-align: center;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.section-header p {
		color: var(--text-secondary);
	}

	.search-filter-container {
		margin-bottom: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.search-wrapper {
		position: relative;
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-tertiary);
		pointer-events: none;
	}

	.search-input {
		width: 100%;
		padding: 0.9rem 1.5rem 0.9rem 3rem;
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--bg-card);
		font-family: 'Outfit', sans-serif;
		font-size: 1rem;
		box-shadow: var(--shadow-sm);
		transition: all 0.2s ease;
	}

	.search-input:focus {
		outline: none;
		border-color: var(--accent-primary);
		box-shadow: 0 0 0 3px rgba(196, 93, 62, 0.1);
	}

	.legend {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin-bottom: 2.5rem;
		justify-content: center;
	}

	.legend-item {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		font-weight: 600;
	}

	.legend-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.restaurant-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: 1.75rem;
	}

	.no-results {
		text-align: center;
		padding: 4rem 0;
		color: var(--text-secondary);
	}

	.no-results a {
		color: var(--accent-primary);
	}

	/* Advertise CTA Banner */
	.advertise-banner {
		background: var(--text-primary);
		padding: 3.5rem 0;
	}

	.advertise-banner-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.advertise-banner h3 {
		color: white;
		font-size: 1.5rem;
		margin-bottom: 0.4rem;
	}

	.advertise-banner p {
		color: rgba(250,246,241,0.65);
		font-size: 0.95rem;
	}

	/* Footer */
	.footer {
		background: #111122;
		color: var(--bg-secondary);
		padding: 3.5rem 0;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
	}

	.footer-brand h3 {
		font-size: 1.3rem;
		margin-bottom: 0.4rem;
		color: white;
	}

	.footer-brand > p {
		font-size: 0.9rem;
		opacity: 0.6;
		margin-bottom: 1rem;
	}

	.footer-nav {
		display: flex;
		gap: 1.25rem;
	}

	.footer-nav a {
		color: rgba(250,246,241,0.5);
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.15s;
	}

	.footer-nav a:hover {
		color: var(--bg-primary);
	}

	.footer-meta {
		text-align: right;
	}

	.footer-meta p {
		font-size: 0.8rem;
		opacity: 0.4;
		margin-bottom: 0.25rem;
	}

	.affiliate-note {
		font-size: 0.75rem !important;
		opacity: 0.3 !important;
		max-width: 280px;
		margin-left: auto;
	}

	@media (max-width: 768px) {
		.stats-container {
			flex-wrap: wrap;
			gap: 1.5rem;
		}
		.stat-divider {
			display: none;
		}
		.hero {
			padding: 4rem 0 6rem;
		}
		.cta-group {
			flex-direction: column;
			align-items: flex-start;
		}
		.newsletter-card {
			flex-direction: column;
			align-items: flex-start;
		}
		.newsletter-form {
			width: 100%;
			flex-direction: column;
		}
		.newsletter-form input {
			width: 100%;
		}
		.featured-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}
		.advertise-banner-inner {
			flex-direction: column;
		}
		.footer-content {
			flex-direction: column;
		}
		.footer-meta {
			text-align: left;
		}
		.affiliate-note {
			margin-left: 0;
		}
	}
</style>
