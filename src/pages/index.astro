---
import BaseLayout from '../layouts/BaseLayout.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import restaurants from '../data/restaurants.json';

// Calculate some stats
const totalRestaurants = restaurants.length;
const neighborhoods = [...new Set(restaurants.map(r => r.neighborhood))].length;
const cuisineTypes = [...new Set(restaurants.map(r => r.cuisine))].length;
---

<BaseLayout title="San Diego Gluten-Free - Celiac-Safe Dining Guide">
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="container hero-content">
				<div class="hero-text">
					<h1>San Diego <br/><span class="accent">Gluten-Free</span></h1>
					<p class="subtitle">A curated guide to the best celiac-safe dining in America's Finest City. Editorial expertise meets local flavor.</p>
					
					<div class="cta-group">
						<a href="#directory" class="btn btn-primary">Explore Directory</a>
						<a href="/essentials" class="btn btn-secondary">GF Essentials</a>
					</div>
				</div>
			</div>
			
			<div class="hero-pattern"></div>
		</section>

		<!-- Stats Bar -->
		<section class="stats">
			<div class="container stats-container">
				<div class="stat-item">
					<span class="stat-value">{totalRestaurants}</span>
					<span class="stat-label">Vetted Spots</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-value">{neighborhoods}</span>
					<span class="stat-label">Neighborhoods</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat-item">
					<span class="stat-value">{cuisineTypes}</span>
					<span class="stat-label">Cuisines</span>
				</div>
			</div>
		</section>

		<!-- Directory Section -->
		<section id="directory" class="directory">
			<div class="container">
				<div class="newsletter-signup bg-accent p-8 rounded-xl text-center mb-16 text-white">
					<h3 class="text-2xl font-bold mb-2">Join the SD GF Community</h3>
					<p class="mb-6 opacity-90">Get weekly updates on new celiac-safe spots, exclusive deals, and local GF news.</p>
					<form class="flex flex-col md:flex-row gap-4 max-w-md mx-auto">
						<input type="email" placeholder="your@email.com" class="p-3 rounded flex-grow text-gray-800" required />
						<button type="submit" class="btn btn-primary bg-white text-accent hover:bg-gray-100">Subscribe</button>
					</form>
				</div>

				<div class="section-header">
					<h2>The Directory</h2>
					<p>Browse by neighborhood, GF safety level, or cuisine.</p>
				</div>

				<div class="search-filter-container">
					<input type="text" id="search" placeholder="Search restaurants, neighborhoods, or cuisine..." class="search-input" />
				</div>

				<!-- Simple Grid for now -->
				<div class="restaurant-grid" id="restaurant-grid">
					{restaurants.map(restaurant => (
						<div class="restaurant-card-wrapper" 
							 data-name={restaurant.name.toLowerCase()} 
							 data-neighborhood={restaurant.neighborhood.toLowerCase()} 
							 data-cuisine={restaurant.cuisine.toLowerCase()}
							 data-notes={restaurant.notes.toLowerCase()}
						>
							<RestaurantCard restaurant={restaurant} />
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="footer">
			<div class="container footer-content">
				<div class="footer-brand">
					<h3>SD Gluten-Free</h3>
					<p>Curated for the celiac community.</p>
				</div>
				<div class="footer-meta">
					<p>Last updated: January 2026 • San Diego, CA</p>
				</div>
			</div>
		</footer>
	</main>

	<script>
		const searchInput = document.getElementById('search') as HTMLInputElement;
		const cards = document.querySelectorAll('.restaurant-card-wrapper');

		searchInput?.addEventListener('input', () => {
			const query = searchInput.value.toLowerCase();
			
			cards.forEach(card => {
				const el = card as HTMLElement;
				const name = el.dataset.name || '';
				const neighborhood = el.dataset.neighborhood || '';
				const cuisine = el.dataset.cuisine || '';
				const notes = el.dataset.notes || '';
				
				if (name.includes(query) || neighborhood.includes(query) || cuisine.includes(query) || notes.includes(query)) {
					el.style.display = 'block';
				} else {
					el.style.display = 'none';
				}
			});
		});
	</script>
</BaseLayout>

<style>
	/* Hero Styles */
	.hero {
		background-color: var(--text-primary);
		color: var(--bg-primary);
		padding: 6rem 0 8rem;
		position: relative;
		overflow: hidden;
	}

	.hero-content {
		position: relative;
		z-index: 2;
	}

	.hero-text {
		max-width: 600px;
	}

	h1 {
		font-size: clamp(3rem, 8vw, 4.5rem);
		margin-bottom: 1.5rem;
		color: var(--bg-primary);
	}

	.accent {
		color: var(--accent-primary);
		font-style: italic;
	}

	.subtitle {
		font-size: 1.2rem;
		opacity: 0.8;
		margin-bottom: 2.5rem;
		font-family: 'Outfit', sans-serif;
	}

	.cta-group {
		display: flex;
		gap: 1rem;
	}

	.btn {
		padding: 0.8rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s ease;
	}

	.btn-primary {
		background-color: var(--accent-primary);
		color: white;
	}

	.btn-primary:hover {
		background-color: var(--accent-hover);
	}

	.btn-secondary {
		background-color: transparent;
		color: var(--bg-primary);
		border: 1px solid rgba(250, 246, 241, 0.3);
	}

	.btn-secondary:hover {
		background-color: rgba(250, 246, 241, 0.1);
	}

	.hero-pattern {
		position: absolute;
		top: 0;
		right: 0;
		width: 50%;
		height: 100%;
		background-image: radial-gradient(var(--accent-primary) 0.5px, transparent 0.5px);
		background-size: 20px 20px;
		opacity: 0.1;
		z-index: 1;
		mask-image: linear-gradient(to left, black, transparent);
	}

	/* Stats Bar */
	.stats {
		background: var(--bg-secondary);
		padding: 2rem 0;
		border-bottom: 1px solid var(--border);
	}

	.stats-container {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 4rem;
	}

	.stat-item {
		text-align: center;
	}

	.stat-value {
		display: block;
		font-family: 'Fraunces', serif;
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-tertiary);
		font-weight: 600;
	}

	.stat-divider {
		width: 1px;
		height: 40px;
		background: var(--border);
	}

	.newsletter-signup {
		background-color: var(--accent-primary);
		margin-top: -4rem;
		position: relative;
		z-index: 10;
		box-shadow: var(--shadow-lg);
	}
	.bg-white { background-color: white !important; }
	.text-accent { color: var(--accent-primary) !important; }
	.flex { display: flex; }
	.flex-col { flex-direction: column; }
	.gap-4 { gap: 1rem; }
	.max-w-md { max-width: 28rem; }
	.mx-auto { margin-left: auto; margin-right: auto; }
	.flex-grow { flex-grow: 1; }
	.text-gray-800 { color: #1f2937; }
	.opacity-90 { opacity: 0.9; }

	@media (min-width: 768px) {
		.md\:flex-row { flex-direction: row; }
	}

	/* Directory Section */
	.directory {
		padding: 6rem 0;
	}

	.section-header {
		margin-bottom: 3rem;
		text-align: center;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
	}

	.section-header p {
		color: var(--text-secondary);
	}

	.search-filter-container {
		margin-bottom: 3rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.search-input {
		width: 100%;
		padding: 1rem 1.5rem;
		border-radius: 4px;
		border: 1px solid var(--border);
		background: var(--bg-card);
		font-family: 'Outfit', sans-serif;
		font-size: 1rem;
		box-shadow: var(--shadow-sm);
		transition: all 0.2s ease;
	}

	.search-input:focus {
		outline: none;
		border-color: var(--accent-primary);
		box-shadow: 0 0 0 3px rgba(196, 93, 62, 0.1);
	}

	.restaurant-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2rem;
	}

	/* Footer */
	.footer {
		background: var(--text-primary);
		color: var(--bg-secondary);
		padding: 4rem 0;
		margin-top: 4rem;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.footer-brand h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.footer-brand p {
		font-size: 0.9rem;
		opacity: 0.6;
	}

	.footer-meta p {
		font-size: 0.8rem;
		opacity: 0.4;
	}

	@media (max-width: 768px) {
		.stats-container {
			flex-direction: column;
			gap: 2rem;
		}
		.stat-divider {
			display: none;
		}
		.hero {
			padding: 4rem 0;
		}
		.cta-group {
			flex-direction: column;
		}
	}
</style>
