---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Advertise — SD Gluten-Free"
	description="Reach thousands of gluten-free and celiac diners in San Diego. Get a featured listing on SD Gluten-Free and grow your restaurant's GF-friendly reputation."
>
	<main>
		<!-- Hero -->
		<section class="adv-hero">
			<div class="container">
				<p class="eyebrow">For Restaurant Owners</p>
				<h1>Reach San Diego's<br /><span class="accent">Celiac Community</span></h1>
				<p class="subtitle">
					SD Gluten-Free is the city's go-to directory for the gluten-free and celiac community.
					A featured listing puts your restaurant in front of highly engaged diners who are
					actively searching for safe options — and who become loyal regulars.
				</p>
				<a href="#pricing" class="btn btn-primary">See Pricing</a>
			</div>
			<div class="hero-pattern"></div>
		</section>

		<!-- Why Advertise Stats -->
		<section class="why-section">
			<div class="container">
				<div class="why-grid">
					<div class="why-stat">
						<span class="why-value">3M+</span>
						<span class="why-label">Americans have celiac disease</span>
					</div>
					<div class="why-stat">
						<span class="why-value">18M+</span>
						<span class="why-label">Follow a gluten-free diet</span>
					</div>
					<div class="why-stat">
						<span class="why-value">High LTV</span>
						<span class="why-label">GF diners are fiercely loyal to safe restaurants</span>
					</div>
					<div class="why-stat">
						<span class="why-value">Word-of-mouth</span>
						<span class="why-label">The GF community shares safe spots constantly</span>
					</div>
				</div>
			</div>
		</section>

		<!-- Pricing Tiers -->
		<section id="pricing" class="pricing-section">
			<div class="container">
				<div class="section-header">
					<h2>Listing Options</h2>
					<p>Simple, transparent pricing. Cancel anytime.</p>
				</div>

				<div class="pricing-grid">
					<!-- Free Tier -->
					<div class="pricing-card">
						<div class="tier-name">Standard</div>
						<div class="tier-price">
							<span class="price-amount">Free</span>
						</div>
						<p class="tier-description">Basic directory listing for any GF-friendly restaurant.</p>
						<ul class="tier-features">
							<li class="feature included">Listed in the directory</li>
							<li class="feature included">GF safety badge</li>
							<li class="feature included">Name, address, phone, website</li>
							<li class="feature not-included">Featured badge</li>
							<li class="feature not-included">Priority placement</li>
							<li class="feature not-included">Newsletter mentions</li>
						</ul>
						<a href="#contact" class="btn btn-outline">Submit Your Restaurant</a>
					</div>

					<!-- Standard Sponsored -->
					<div class="pricing-card pricing-card-highlight">
						<div class="popular-badge">Most Popular</div>
						<div class="tier-name">Sponsored</div>
						<div class="tier-price">
							<span class="price-amount">$79</span>
							<span class="price-period">/month</span>
						</div>
						<p class="tier-description">Stand out with a featured badge and priority placement in the directory.</p>
						<ul class="tier-features">
							<li class="feature included">Everything in Standard</li>
							<li class="feature included">Gold "Sponsored Listing" badge</li>
							<li class="feature included">Featured section at top of directory</li>
							<li class="feature included">Priority in search results</li>
							<li class="feature included">Enhanced profile card</li>
							<li class="feature not-included">Newsletter feature</li>
						</ul>
						<a href="#contact" class="btn btn-primary">Get Started</a>
					</div>

					<!-- Premium -->
					<div class="pricing-card">
						<div class="tier-name">Premium</div>
						<div class="tier-price">
							<span class="price-amount">$149</span>
							<span class="price-period">/month</span>
						</div>
						<p class="tier-description">Maximum visibility — homepage placement and newsletter features.</p>
						<ul class="tier-features">
							<li class="feature included">Everything in Sponsored</li>
							<li class="feature included">Monthly newsletter feature</li>
							<li class="feature included">Homepage hero spotlight</li>
							<li class="feature included">Social media shout-out</li>
							<li class="feature included">Detailed menu/photo section</li>
							<li class="feature included">Dedicated blog post (quarterly)</li>
						</ul>
						<a href="#contact" class="btn btn-outline">Contact Us</a>
					</div>
				</div>

				<p class="pricing-note">All plans are month-to-month. No long-term contracts. Prices in USD.</p>
			</div>
		</section>

		<!-- What You Get Detail -->
		<section class="benefits-section">
			<div class="container">
				<div class="benefits-grid">
					<div class="benefit-item">
						<div class="benefit-icon">📍</div>
						<h3>Prime Real Estate</h3>
						<p>Featured listings appear at the very top of the directory, above the 40+ standard listings — the first thing visitors see.</p>
					</div>
					<div class="benefit-item">
						<div class="benefit-icon">⭐</div>
						<h3>Gold Sponsored Badge</h3>
						<p>A highly visible gold "Sponsored Listing" badge signals to diners that your restaurant invests in the GF community.</p>
					</div>
					<div class="benefit-item">
						<div class="benefit-icon">📧</div>
						<h3>Newsletter Reach</h3>
						<p>Premium partners get featured in our weekly email newsletter sent to celiac-focused subscribers across San Diego.</p>
					</div>
					<div class="benefit-item">
						<div class="benefit-icon">🔍</div>
						<h3>SEO Benefit</h3>
						<p>Your restaurant gets its own indexed page on our site with Schema.org markup — helping you rank for local GF searches.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Form -->
		<section id="contact" class="contact-section">
			<div class="container contact-container">
				<div class="contact-text">
					<h2>Get In Touch</h2>
					<p>Tell us about your restaurant and we'll reach out within 24 hours to get your featured listing live.</p>
					<div class="contact-info-list">
						<div class="contact-info-item">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
							<a href="mailto:partnerships@sdglutenfree.com">partnerships@sdglutenfree.com</a>
						</div>
						<p class="contact-note">Average response time: under 24 hours</p>
					</div>
				</div>

				<!--
					Contact form powered by Formspree (free for up to 50 submissions/month).
					1. Sign up at https://formspree.io
					2. Create a new form
					3. Replace YOUR_FORM_ID below with your actual form ID
				-->
				<form
					action="https://formspree.io/f/YOUR_FORM_ID"
					method="POST"
					class="contact-form"
				>
					<div class="form-row">
						<div class="form-group">
							<label for="restaurant-name">Restaurant Name *</label>
							<input type="text" id="restaurant-name" name="restaurant_name" required placeholder="e.g. Casa Del Mar" />
						</div>
						<div class="form-group">
							<label for="contact-name">Your Name *</label>
							<input type="text" id="contact-name" name="contact_name" required placeholder="First Last" />
						</div>
					</div>
					<div class="form-row">
						<div class="form-group">
							<label for="email">Email Address *</label>
							<input type="email" id="email" name="email" required placeholder="you@restaurant.com" />
						</div>
						<div class="form-group">
							<label for="phone">Phone Number</label>
							<input type="tel" id="phone" name="phone" placeholder="619-555-0100" />
						</div>
					</div>
					<div class="form-group">
						<label for="plan">Interested In</label>
						<select id="plan" name="plan">
							<option value="">Select a plan...</option>
							<option value="sponsored">Sponsored — $79/month</option>
							<option value="premium">Premium — $149/month</option>
							<option value="standard">Standard (Free) Listing</option>
							<option value="not-sure">Not sure yet — tell me more</option>
						</select>
					</div>
					<div class="form-group">
						<label for="message">Tell Us About Your GF Options</label>
						<textarea id="message" name="message" rows="4" placeholder="What gluten-free accommodations do you offer? Dedicated kitchen? 100% GF menu? Celiac-trained staff?"></textarea>
					</div>
					<button type="submit" class="btn btn-primary btn-full">Send Message</button>
					<p class="form-disclaimer">We'll never share your information. By submitting, you agree to be contacted about listing options.</p>
				</form>
			</div>
		</section>

		<!-- FAQ -->
		<section class="faq-section">
			<div class="container">
				<h2>Frequently Asked Questions</h2>
				<div class="faq-grid">
					<div class="faq-item">
						<h3>How quickly will my listing go live?</h3>
						<p>Sponsored and Premium listings go live within 24-48 hours after payment confirmation.</p>
					</div>
					<div class="faq-item">
						<h3>Do I need a contract?</h3>
						<p>No. All plans are month-to-month. Cancel any time with 7 days notice.</p>
					</div>
					<div class="faq-item">
						<h3>Can I update my listing?</h3>
						<p>Yes! Email us any time to update hours, photos, menu info, or GF protocols.</p>
					</div>
					<div class="faq-item">
						<h3>What if I'm already listed for free?</h3>
						<p>You can upgrade your free listing to Sponsored or Premium at any time — we'll update it immediately.</p>
					</div>
					<div class="faq-item">
						<h3>How do you verify GF options?</h3>
						<p>We research each restaurant's menu, policies, and training. Sponsored partners get a detailed intake form and we publish exactly what you tell us.</p>
					</div>
					<div class="faq-item">
						<h3>Do you offer annual discounts?</h3>
						<p>Yes — pay annually and save 2 months (equivalent to ~17% off). Ask us about annual pricing in your message.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Footer -->
		<footer class="footer">
			<div class="container footer-content">
				<div class="footer-brand">
					<h3>SD Gluten-Free</h3>
					<p>Curated for the celiac community of San Diego.</p>
					<div class="footer-nav">
						<a href="/">Directory</a>
						<a href="/essentials">GF Essentials</a>
						<a href="/advertise">Advertise</a>
					</div>
				</div>
				<div class="footer-meta">
					<p>&copy; 2026 SD Gluten-Free &middot; San Diego, CA</p>
				</div>
			</div>
		</footer>
	</main>
</BaseLayout>

<style>
	/* Hero */
	.adv-hero {
		background: var(--text-primary);
		color: var(--bg-primary);
		padding: 6rem 0 8rem;
		position: relative;
		overflow: hidden;
	}

	.eyebrow {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent-primary);
		font-weight: 700;
		margin-bottom: 1rem;
	}

	h1 {
		font-size: clamp(2.5rem, 6vw, 4rem);
		margin-bottom: 1.5rem;
		color: var(--bg-primary);
	}

	.accent {
		color: var(--accent-primary);
		font-style: italic;
	}

	.subtitle {
		font-size: 1.1rem;
		opacity: 0.75;
		margin-bottom: 2.5rem;
		max-width: 580px;
		line-height: 1.7;
	}

	.btn {
		display: inline-block;
		padding: 0.85rem 1.75rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.9rem;
		transition: all 0.2s ease;
		cursor: pointer;
		font-family: 'Outfit', sans-serif;
	}

	.btn-primary {
		background: var(--accent-primary);
		color: white;
		border: none;
	}

	.btn-primary:hover {
		background: var(--accent-hover);
	}

	.btn-outline {
		background: transparent;
		color: var(--accent-primary);
		border: 2px solid var(--accent-primary);
	}

	.btn-outline:hover {
		background: var(--accent-primary);
		color: white;
	}

	.btn-full {
		width: 100%;
		text-align: center;
	}

	.hero-pattern {
		position: absolute;
		top: 0; right: 0;
		width: 50%; height: 100%;
		background-image: radial-gradient(var(--accent-primary) 0.5px, transparent 0.5px);
		background-size: 20px 20px;
		opacity: 0.08;
		z-index: 1;
		mask-image: linear-gradient(to left, black, transparent);
	}

	.adv-hero .container {
		position: relative;
		z-index: 2;
	}

	/* Why Section */
	.why-section {
		background: var(--bg-secondary);
		padding: 3.5rem 0;
		border-bottom: 1px solid var(--border);
	}

	.why-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
		text-align: center;
	}

	.why-stat {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.why-value {
		font-family: 'Fraunces', serif;
		font-size: 1.8rem;
		font-weight: 700;
		color: var(--accent-primary);
	}

	.why-label {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.4;
	}

	/* Pricing */
	.pricing-section {
		padding: 5rem 0;
	}

	.section-header {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.section-header h2 {
		font-size: 2.2rem;
		margin-bottom: 0.5rem;
	}

	.section-header p {
		color: var(--text-secondary);
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		max-width: 1000px;
		margin: 0 auto;
	}

	.pricing-card {
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 2rem;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.pricing-card-highlight {
		border-color: var(--accent-primary);
		box-shadow: 0 4px 24px rgba(196, 93, 62, 0.12);
	}

	.popular-badge {
		position: absolute;
		top: -12px;
		left: 50%;
		transform: translateX(-50%);
		background: var(--accent-primary);
		color: white;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.75rem;
		border-radius: 20px;
		white-space: nowrap;
	}

	.tier-name {
		font-size: 0.8rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--text-tertiary);
		margin-bottom: 0.75rem;
	}

	.tier-price {
		margin-bottom: 1rem;
	}

	.price-amount {
		font-family: 'Fraunces', serif;
		font-size: 2.5rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.price-period {
		font-size: 0.95rem;
		color: var(--text-tertiary);
		margin-left: 0.2rem;
	}

	.tier-description {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		line-height: 1.5;
	}

	.tier-features {
		list-style: none;
		margin-bottom: 2rem;
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.feature {
		font-size: 0.875rem;
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.feature::before {
		content: '';
		width: 16px;
		height: 16px;
		border-radius: 50%;
		flex-shrink: 0;
		background-size: contain;
		background-repeat: no-repeat;
	}

	.feature.included {
		color: var(--text-primary);
	}

	.feature.included::before {
		content: '✓';
		background: none;
		color: var(--gf-verified);
		font-weight: 700;
		font-size: 0.8rem;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.feature.not-included {
		color: var(--text-tertiary);
		text-decoration: line-through;
	}

	.feature.not-included::before {
		content: '–';
		background: none;
		color: var(--text-tertiary);
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.pricing-note {
		text-align: center;
		font-size: 0.85rem;
		color: var(--text-tertiary);
		margin-top: 2rem;
	}

	/* Benefits */
	.benefits-section {
		background: var(--bg-secondary);
		padding: 5rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.benefits-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
	}

	.benefit-item {
		text-align: center;
	}

	.benefit-icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}

	.benefit-item h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}

	.benefit-item p {
		font-size: 0.875rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	/* Contact */
	.contact-section {
		padding: 5rem 0;
	}

	.contact-container {
		display: grid;
		grid-template-columns: 1fr 1.5fr;
		gap: 4rem;
		align-items: start;
	}

	.contact-text h2 {
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.contact-text > p {
		color: var(--text-secondary);
		margin-bottom: 2rem;
		line-height: 1.7;
	}

	.contact-info-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.contact-info-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.95rem;
	}

	.contact-info-item svg {
		color: var(--accent-primary);
		flex-shrink: 0;
	}

	.contact-info-item a {
		color: var(--accent-primary);
		text-decoration: none;
	}

	.contact-info-item a:hover {
		text-decoration: underline;
	}

	.contact-note {
		font-size: 0.8rem;
		color: var(--text-tertiary);
		margin-left: 2.25rem;
	}

	/* Form */
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		background: var(--bg-card);
		padding: 2.5rem;
		border-radius: 8px;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-sm);
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-group label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-secondary);
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		font-family: 'Outfit', sans-serif;
		font-size: 0.95rem;
		background: var(--bg-primary);
		color: var(--text-primary);
		transition: border-color 0.15s;
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--accent-primary);
		box-shadow: 0 0 0 3px rgba(196, 93, 62, 0.1);
	}

	.form-group textarea {
		resize: vertical;
	}

	.form-disclaimer {
		font-size: 0.75rem;
		color: var(--text-tertiary);
		text-align: center;
	}

	/* FAQ */
	.faq-section {
		background: var(--bg-secondary);
		padding: 5rem 0;
		border-top: 1px solid var(--border);
	}

	.faq-section h2 {
		font-size: 2rem;
		text-align: center;
		margin-bottom: 3rem;
	}

	.faq-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.faq-item h3 {
		font-size: 1rem;
		margin-bottom: 0.5rem;
	}

	.faq-item p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.6;
	}

	/* Footer */
	.footer {
		background: #111122;
		color: var(--bg-secondary);
		padding: 3rem 0;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 2rem;
	}

	.footer-brand h3 {
		font-size: 1.2rem;
		margin-bottom: 0.4rem;
		color: white;
	}

	.footer-brand > p {
		font-size: 0.875rem;
		opacity: 0.5;
		margin-bottom: 1rem;
	}

	.footer-nav {
		display: flex;
		gap: 1.25rem;
	}

	.footer-nav a {
		color: rgba(250,246,241,0.45);
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.15s;
	}

	.footer-nav a:hover {
		color: var(--bg-primary);
	}

	.footer-meta p {
		font-size: 0.8rem;
		opacity: 0.35;
	}

	@media (max-width: 900px) {
		.why-grid,
		.benefits-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.pricing-grid {
			grid-template-columns: 1fr;
