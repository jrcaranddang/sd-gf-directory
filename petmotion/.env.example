# ---- Expo client (public) ----
# These are safe to ship in the client bundle. The anon key is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx

# ---- Supabase Edge Functions (server-only secrets) ----
# Set via `supabase secrets set KEY=value`. NEVER ship these to the client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
BYTEPLUS_API_KEY=your-byteplus-modelark-key
RC_SECRET_KEY=your-revenuecat-secret-key

# Provider selection: mock | byteplus | fal
PROVIDER=mock

# Cost guards
MAX_DAILY_JOBS=10          # per-user hard cap regardless of plan
GLOBAL_MAX_DAILY_JOBS=500  # global kill-switch across all users
WEEKLY_QUOTA=30            # generations/week on paid
